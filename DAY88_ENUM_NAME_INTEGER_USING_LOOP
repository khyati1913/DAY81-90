Q138: Print all enum names and integer values using a loop.

/*
Sample Test Cases:
Input 1:
No input
Output 1:
RED=0
YELLOW=1
GREEN=2

*/


#include <stdio.h>

enum colors { RED, YELLOW, GREEN };

int main()
{
    enum colors c;     // enum variable

    for(c = RED; c <= GREEN; c++)
    {
        if(c == RED)
            printf("RED=%d\n", c);
        else if(c == YELLOW)
            printf("YELLOW=%d\n", c);
        else if(c == GREEN)
            printf("GREEN=%d\n", c);
    }

    return 0;
}
