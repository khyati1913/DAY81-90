Q136: Use enum to represent menu choices (ADD, SUBTRACT, MULTIPLY) and perform operations using switch.

/*
Sample Test Cases:
Input 1:
ADD 10 20
Output 1:
30

*/

#include <stdio.h>

enum menu { ADD = 1, SUBTRACT, MULTIPLY };

int main() {
    int choice;
    int a, b, result;

    printf("Enter choice (1-ADD, 2-SUBTRACT, 3-MULTIPLY): ");
    scanf("%d", &choice);

    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);

    switch(choice) {
        case ADD:
            result = a + b;
            printf("%d\n", result);
            break;

        case SUBTRACT:
            result = a - b;
            printf("%d\n", result);
            break;

        case MULTIPLY:
            result = a * b;
            printf("%d\n", result);
            break;

        default:
            printf("Invalid choice\n");
    }

    return 0;
}
